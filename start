#!/bin/sh
set -eu

mode=${1:-all}
case "$mode" in
    all|test|demo) ;;
    *)
        printf 'Usage: %s [test|demo]\n' "$0" >&2
        exit 2
        ;;
esac

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
build_dir="$project_dir/build"

printf '\n[1/3] Configuring Debug build...\n'
cmake -S "$project_dir" -B "$build_dir" -DCMAKE_BUILD_TYPE=Debug

printf '\n[2/3] Building...\n'
cmake --build "$build_dir" --parallel

printf '\n[3/3] Running tests...\n'
ctest --test-dir "$build_dir" --output-on-failure

if [ "$mode" = demo ]; then
    printf '\nStarting demonstration...\n'
    exec "$build_dir/order_demo" --demo
fi

if [ "$mode" = all ]; then
    printf '\nStarting interactive menu...\n'
    exec "$build_dir/order_demo"
fi
